# Core runtime
KALSHI_ENV=prod
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
# Keep true in production. Set false only for local TLS-debug fallback.
KALSHI_WS_VERIFY_TLS=true
# Optional: absolute CA bundle path if your Python cert store is broken.
# KALSHI_WS_CA_BUNDLE_PATH=/etc/ssl/certs/ca-bundle.crt
KALSHI_API_KEY_ID=your_api_key_id
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem
# Optional inline key (supports literal \n escapes). Prefer this OR path, not both.
# KALSHI_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Bot config
MARKET_SEED_TICKER=KXBTC15M-26FEB151715
# Optional multi-market mode (comma-separated). When set, runs all in parallel.
MARKET_SEED_TICKERS=KXBTC15M-26FEB151715,KXETH15M-26FEB152300,KXSOL15M-26FEB161315,KXXRP15M-26FEB161315
AUTO_ROLL=true
PAPER_MODE=false
BANKROLL_USD=3000
MAX_DAILY_LOSS_PCT=0.025
MAX_GROSS_EXPOSURE_PCT=0.20
MAX_MARKET_EXPOSURE_PCT=0.06
MAX_BET_PCT=0.33
DASHBOARD_INTERVAL_SEC=5
KILL_SWITCH_FILE=/Users/realtonypark/Developer/printer/.halt_trading

# Execution/risk filters
MAX_SPREAD_CENTS=6
MIN_TOP_BOOK_DEPTH=0
MAX_REST_LATENCY_MS=800
STALE_FEED_SEC=4
MARKET_CLOSE_BUFFER_SEC=45
ENTRY_AT_SESSION_START_ONLY=true
SESSION_DURATION_SEC=900
SESSION_START_ENTRY_WINDOW_SEC=120
MANDATORY_SESSION_ENTRY=true
MANDATORY_ENTRY_CONTRACTS=1
MAX_CONSECUTIVE_API_ERRORS=5
MAX_INITIAL_ORDER_CONTRACTS=25
MAKER_EDGE_CENTS=2
TAKER_CONFIDENCE_THRESHOLD=0.45
TAKER_MIN_EDGE_CENTS=1
FEE_BUFFER_CENTS=1
DIRECTIONAL_ONLY=true
FORCE_DIRECTIONAL_ENTRIES=true
MOMENTUM_LOOKBACK=8
MOMENTUM_MIN_CENTS=0.08
ENTRY_COOLDOWN_SEC=30
USE_TECHNICAL_ANALYSIS=true
TA_REFRESH_SEC=5
TA_REQUIRE_5M_ALIGNMENT=true
TA_5M_MIN_STRENGTH=0.45
TA_REQUIRE_15M_ALIGNMENT=true
TA_15M_MIN_STRENGTH=0.60
SKIP_CHOPPY_REGIME=true
REGIME_MIN_TREND_STRENGTH_BPS=4.0
REGIME_CHOP_VOL_1M=0.001
PROBABILITY_CALIBRATION_SLOPE=0.85
PROBABILITY_CALIBRATION_INTERCEPT=0.0
PROBABILITY_SHRINK=0.18
DIRECTIONAL_SCORE_THRESHOLD=0.55
MIN_SIGNAL_CONFIRMATIONS=3
SIGNAL_CONFIRMATION_WINDOW=6
ASSUMED_FEE_PER_CONTRACT_CENTS=1
ASSUMED_SLIPPAGE_CENTS=1
MIN_WIN_PROFIT_CENTS=2
MIN_EXPECTED_VALUE_CENTS=0.25
EV_SAFETY_CENTS=0.15
BASE_TRADE_RISK_PCT=0.0015
MAX_TRADE_RISK_PCT=0.01
KELLY_FRACTION=0.20
SIZE_TARGET_EV_CENTS=2.5

# Logging and storage
DATA_DIR=/Users/realtonypark/Developer/printer/data
LOG_DIR=/Users/realtonypark/Developer/printer/logs
